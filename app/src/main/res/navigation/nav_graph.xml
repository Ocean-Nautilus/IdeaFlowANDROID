<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/ideasFragment">

    <fragment
        android:id="@+id/ideasFragment"
        android:name="com.nautilus.ideas.ui.ideas.IdeasFragment"
        android:label="@string/tab_ideas"
        tools:layout="@layout/fragment_ideas">

        <!-- Нажатие на карточку - детальный просмотр. -->
        <action
            android:id="@+id/action_ideas_to_details"
            app:destination="@id/ideaDetailsFragment" />

        <!-- Кнопка "+" - пустая форма создания. -->
        <action
            android:id="@+id/action_ideas_to_editor"
            app:destination="@id/ideaEditorFragment" />

    </fragment>

    <fragment
        android:id="@+id/statsFragment"
        android:name="com.nautilus.ideas.ui.stats.StatsFragment"
        android:label="@string/tab_stats"
        tools:layout="@layout/fragment_stats" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.nautilus.ideas.ui.settings.SettingsFragment"
        android:label="@string/tab_settings"
        tools:layout="@layout/fragment_settings" />

    <!-- Детальный просмотр. Аргумент обязательный: без идеи
         экрану нечего показывать. -->
    <fragment
        android:id="@+id/ideaDetailsFragment"
        android:name="com.nautilus.ideas.ui.details.IdeaDetailsFragment"
        android:label="@string/details_title"
        tools:layout="@layout/fragment_idea_details">

        <argument
            android:name="ideaId"
            app:argType="long" />

        <!-- Правка открывается уже отсюда. -->
        <action
            android:id="@+id/action_details_to_editor"
            app:destination="@id/ideaEditorFragment" />

    </fragment>

    <!-- Экран формы. Не вкладка нижнего меню: открывается поверх
         списка, поэтому меню на нём скрывается. -->
    <fragment
        android:id="@+id/ideaEditorFragment"
        android:name="com.nautilus.ideas.ui.editor.IdeaEditorFragment"
        android:label="@string/editor_title_new"
        tools:layout="@layout/fragment_idea_editor">

        <argument
            android:name="ideaId"
            android:defaultValue="-1L"
            app:argType="long" />

    </fragment>

</navigation>
